# ─────────────────────────────────────────────────────────────────────────────
# Frontend (Next.js) environment — copy to `.env.local` and fill in real values.
#
# SERVER-ONLY. Never prefix any of these with NEXT_PUBLIC_ — that would inline
# the value into the browser bundle. The browser reaches Strapi only through the
# Next.js /api/* routes, never directly.
# ─────────────────────────────────────────────────────────────────────────────

# Base URL of the Strapi backend (no trailing slash).
# Local dev:      http://localhost:1337
# Same-host VPS:  http://127.0.0.1:1337
STRAPI_URL=http://localhost:1337

# Strapi API token (Settings → API Tokens in the Strapi admin).
# Generate a fresh token on the server — do NOT reuse a token that was ever
# exposed to a browser.
STRAPI_TOKEN=replace-with-a-fresh-strapi-api-token

# OpenAI key — used by the data-import / tagging pipeline (app/lib/import-prompts.ts).
OPENAI_API_KEY=sk-replace-me

# Optional. Only needed if a stage in app/lib/import-prompts.ts uses
# provider: "anthropic".
# ANTHROPIC_API_KEY=sk-ant-replace-me
