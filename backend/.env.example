# ─────────────────────────────────────────────────────────────────────────────
# Strapi backend environment — copy to `.env` and fill in real values.
# Generate every secret fresh on the server. NEVER commit the real `.env`.
#
# Quick way to generate a random secret:
#   node -e "console.log(require('crypto').randomBytes(16).toString('base64'))"
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=1337

# ── Secrets (generate unique random values) ─────────────────────────────────
# APP_KEYS is a comma-separated list of at least two keys.
APP_KEYS="changeMe1,changeMe2"
API_TOKEN_SALT=changeMe
ADMIN_JWT_SECRET=changeMe
TRANSFER_TOKEN_SALT=changeMe
JWT_SECRET=changeMe
ENCRYPTION_KEY=changeMe

# ── Database ─────────────────────────────────────────────────────────────────
# Production uses PostgreSQL. Set DATABASE_CLIENT=sqlite for a quick local run.
DATABASE_CLIENT=postgres
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=strapi
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=changeMe
DATABASE_SSL=false
# Only used when DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db
